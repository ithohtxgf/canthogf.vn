# Admin CMS — đăng nhập Supabase Auth (email + mật khẩu)
# 1) Supabase Dashboard → Authentication → Users → Add user
# 2) Khai báo email admin được phép (phân tách bằng dấu phẩy)
ADMIN_ALLOWED_EMAILS=admin@example.com

# SEO AI assistant (tuỳ chọn)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Supabase — BẮT BUỘC trên Vercel Production
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL
NEXT_PUBLIC_SITE_URL=https://canthogf.vn

# Storage CDN (tự bật khi có Supabase)
SUPABASE_STORAGE_BUCKET=canthogf-media

# Dev local không có Supabase → fallback SQLite (data/canthogf.db)
