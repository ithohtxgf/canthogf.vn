# Sao chép thành .env.local rồi điền giá trị thật (một file duy nhất cho dev local)
# cp .env.example .env.local

# --- Cách 1: Database (bảng admin_users) — khuyến nghị cho skill/automation ---
# Tạo admin: npm run db:seed-admin -- admin@example.com your-password "Tên admin"
# Hoặc khai báo dưới đây (dev local SQLite tự seed lần đầu):
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Admin Cần Thơ GF
# Cookie session DB auth (tuỳ chọn — mặc định dùng SUPABASE_SERVICE_ROLE_KEY)
# ADMIN_SESSION_SECRET=random-long-secret

# --- Cách 2: Supabase Auth (email + mật khẩu trong Supabase Dashboard) ---
# 1) Supabase Dashboard → Authentication → Users → Add user
# 2) Khai báo email admin được phép (phân tách bằng dấu phẩy)
ADMIN_ALLOWED_EMAILS=admin@example.com

# SEO AI assistant (tuỳ chọn)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Supabase — BẮT BUỘC trên Vercel Production
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL
NEXT_PUBLIC_SITE_URL=https://canthogf.vn

# Storage CDN (tự bật khi có Supabase)
SUPABASE_STORAGE_BUCKET=canthogf-media

# Dev local không có Supabase → fallback SQLite (data/canthogf.db)
