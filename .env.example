# Admin CMS — BẮT BUỘC trên Vercel Production
ADMIN_PASSWORD=your-strong-password-here

# SEO AI assistant (tuỳ chọn)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Supabase — BẮT BUỘC trên Vercel Production (SQLite không chạy trên serverless)
# Tạo project: https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage CDN (tự bật khi có Supabase — tắt: SUPABASE_STORAGE_ENABLED=false)
SUPABASE_STORAGE_BUCKET=canthogf-media
# SUPABASE_STORAGE_ENABLED=false

# Nếu chưa cấu hình Supabase, app fallback SQLite local (data/canthogf.db)
